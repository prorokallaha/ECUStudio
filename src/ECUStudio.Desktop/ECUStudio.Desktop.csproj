<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows desktop shell: hosts ECUStudio.Api in-process on a random loopback port and shows the
    React UI in WebView2. Publish as a single self-contained ECUStudio.exe:
      dotnet publish src/ECUStudio.Desktop -c Release -r win-x64
    (frontend export must be copied to wwwroot first, see build/publish-desktop.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ECUStudio</AssemblyName>
    <RootNamespace>ECUStudio.Desktop</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- WebView2 package also ships a WPF control that references WindowsBase 5.0; harmless for WinForms. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- ECUStudio.Api is referenced as a library (ApiHost); its own exe entry point is unused here. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECUStudio.Api\ECUStudio.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ECUStudio.Api\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
