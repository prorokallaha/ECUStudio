    "echarts-gl": "^2.1.0",
    "lucide-react": "*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^3",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
